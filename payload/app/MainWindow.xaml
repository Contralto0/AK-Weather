<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AK-Weather" Width="1120" Height="820" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" Foreground="#192C40">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="19,11"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#243E55"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E2E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#008C88"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootLayout" Background="#F4F6F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142A3C">
      <Grid Margin="22,30,22,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="37" Height="37" Background="#42CCB9" CornerRadius="11" Margin="0,0,10,0"><TextBlock Text="AK" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="AK-Weather" Foreground="White" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Wetter. Mit Perspektive." Foreground="#A1B9C8" FontSize="12" Margin="0,15,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,45,0,0">
          <TextBlock Text="DEIN WETTER" Foreground="#88A2B5" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,14"/>
          <Border Background="#254759" CornerRadius="8" Padding="14,13"><TextBlock Text="◉   Übersicht" Foreground="#B3F3E6" FontSize="14" FontWeight="SemiBold"/></Border>
          <TextBlock Text="Vorhersage" Foreground="#A1B9C8" FontSize="14" Margin="16,23,0,0"/>
          <TextBlock Text="In Vorbereitung" Foreground="#8DA7B9" FontSize="11" Margin="16,5,0,0"/>
          <TextBlock Text="Meine Orte" Foreground="#A1B9C8" FontSize="14" Margin="16,23,0,0"/>
          <TextBlock Text="In Vorbereitung" Foreground="#8DA7B9" FontSize="11" Margin="16,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border Background="#203D50" CornerRadius="8" Padding="12" Margin="0,0,0,21">
            <StackPanel><TextBlock Text="DER ANFANG IST DA." Foreground="#78DCCB" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Eine Wetter-App wächst." Foreground="#D0DEE7" FontSize="12" Margin="0,7,0,0"/></StackPanel>
          </Border>
          <TextBlock x:Name="SidebarVersion" Text="VERSION 0.1.0" Foreground="#A1B9C8" FontSize="10"/>
          <TextBlock Text="Von Andy Klemann" Foreground="#A1B9C8" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="34,29,34,22">
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Übersicht" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Willkommen bei AK-Weather" FontSize="13" Foreground="#647586" Margin="0,6,0,0"/></StackPanel>
          <Border Grid.Column="1" Background="#E4F2EB" CornerRadius="16" Padding="12,7" VerticalAlignment="Top" Margin="16,5,0,0"><TextBlock Text="●  In Entwicklung" Foreground="#26725B" FontSize="12"/></Border>
        </Grid>
        <Border Background="#E4F0F3" CornerRadius="16" Padding="28,25,24,25">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="177"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MEILENSTEIN 01" FontSize="10" FontWeight="Bold" Foreground="#267C7B"/>
              <TextBlock Text="Das Grundsystem steht." FontSize="30" FontWeight="SemiBold" Margin="0,10,0,13"/>
              <TextBlock Text="Hier entsteht deine Wetter-App. Die Basis ist bereit – jetzt wächst AK-Weather Schritt für Schritt." FontSize="14" LineHeight="23" Foreground="#486478"/>
              <Border Background="#F5FAFA" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left" Margin="0,19,0,0"><TextBlock Text="Erste Entwicklung · Grundsystem" FontSize="11" Foreground="#326568"/></Border>
            </StackPanel>
            <Viewbox Grid.Column="1" Width="158" Height="159" Margin="18,0,0,0" VerticalAlignment="Center">
              <Canvas Width="180" Height="180">
                <Ellipse Canvas.Left="33" Canvas.Top="22" Width="135" Height="135" Fill="#D4E8EB"/>
                <Ellipse Canvas.Left="78" Canvas.Top="33" Width="64" Height="64" Fill="#F5BE56"/>
                <Path Stroke="#EAB14D" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M110,17 L110,9 M149,31 L155,25 M158,64 L167,64 M75,29 L69,23"/>
                <Path Fill="#FCFEFF" Data="M42,126 C16,126 13,88 40,82 C43,52 86,45 101,76 C128,69 152,89 150,111 C150,126 137,132 124,132 L45,132 Z"/>
                <Path Stroke="#4F9FAF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M57,144 L52,154 M84,146 L79,156 M111,144 L106,154"/>
              </Canvas>
            </Viewbox>
          </Grid>
        </Border>
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="#E3E9EE" BorderThickness="1" CornerRadius="12" Padding="21">
            <StackPanel><TextBlock Text="WETTERDATEN" FontSize="10" FontWeight="SemiBold" Foreground="#748491"/><TextBlock Text="Noch ein wenig Geduld." FontSize="17" FontWeight="SemiBold" Margin="0,12,0,9"/><TextBlock Text="Aktuelle Temperaturen und Vorhersagen folgen in einer kommenden Version." FontSize="13" Foreground="#647586" LineHeight="21"/><TextBlock Text="Es werden noch keine Wetterdaten abgerufen." FontSize="11" Foreground="#667885" Margin="0,13,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="2" Background="White" BorderBrush="#E3E9EE" BorderThickness="1" CornerRadius="12" Padding="21">
            <StackPanel><TextBlock Text="DAS IST SCHON BEREIT" FontSize="10" FontWeight="SemiBold" Foreground="#748491"/><TextBlock Text="Ein guter Start." FontSize="17" FontWeight="SemiBold" Margin="0,12,0,11"/><TextBlock Text="✓  Eigenständige Windows-App" FontSize="13" Foreground="#3D645D" Margin="0,0,0,8"/><TextBlock Text="✓  Python-Laufzeit enthalten" FontSize="13" Foreground="#3D645D" Margin="0,0,0,8"/><TextBlock Text="✓  Automatische Updateprüfung" FontSize="13" Foreground="#3D645D"/></StackPanel>
          </Border>
        </Grid>
        <Border Background="White" BorderBrush="#E3E9EE" BorderThickness="1" CornerRadius="12" Padding="21" Margin="0,20,0,0">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Immer einen Schritt weiter." FontSize="17" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="UPDATES" FontSize="10" Foreground="#748491" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <TextBlock x:Name="UpdateStatus" Text="Updates werden beim Start automatisch geprüft." FontSize="13" Foreground="#647586" Margin="0,11,0,0" LineHeight="21" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="UpdateProgress" Height="3" Margin="0,13,0,0" Foreground="#248D85" Background="#EAF0F3" BorderThickness="0" Visibility="Collapsed" IsIndeterminate="True"/>
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="CheckUpdates" Content="Nach Updates suchen" Background="#1B756F" Foreground="White" BorderBrush="#1B756F" Margin="0,0,10,0"/>
              <Button x:Name="RestartApp" Content="Jetzt neu starten" Visibility="Collapsed" Margin="0,0,10,0"/>
              <Button x:Name="OpenProject" Content="Projekt auf GitHub ↗"/>
            </WrapPanel>
            <TextBlock x:Name="UpdateDetail" Text="Neue Versionen werden im Hintergrund vorbereitet." FontSize="11" Foreground="#758591" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="RecoveryNotice" Visibility="Collapsed" Foreground="#8A5A1C" FontSize="12" Margin="0,13,0,0" Text="Die letzte Version konnte nicht starten. Das mitgelieferte Grundsystem wurde geöffnet. Hinweise zur Wiederherstellung stehen in der Dokumentation."/>
        <Grid Margin="0,21,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="© 2026 Andy Klemann · Frei verwendbar. Änderungen nicht gestattet." FontSize="10" Foreground="#667784"/><TextBlock Text="Mit KI-Unterstützung programmiert. Drittanbieter-Komponenten unter eigenen Lizenzen." FontSize="10" Foreground="#748491" Margin="0,4,0,0"/></StackPanel>
          <Button x:Name="OpenDocs" Grid.Column="1" Content="Dokumentation" FontSize="11" Padding="9,6" Margin="12,0,0,0" VerticalAlignment="Top"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
